{% comment %}
  Free-shipping progress bar for the cart drawer and cart page.
  Threshold comes from theme settings (Gondals > Free shipping bar), in the store currency.
  Hidden when the threshold is 0, the cart is empty, or the customer shops in another currency
  (Liquid has no exchange rate, so a converted amount would be wrong).

  Accepts:
  - key: {String} Unique id per placement so the fill animates from its previous value

  Usage:
  {% render 'gondals-free-shipping', key: 'drawer' %}
{% endcomment %}

{%- liquid
  assign threshold = settings.gondals_free_shipping_threshold | default: 0 | times: 100 | round
  assign show_bar = true
  if threshold <= 0 or cart == empty or cart.currency.iso_code != shop.currency
    assign show_bar = false
  endif

  if show_bar
    assign total = cart.total_price
    assign remaining = threshold | minus: total
    assign remaining_money = remaining | money
    assign percent = total | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  endif
-%}

{%- if show_bar -%}
  <gondals-free-shipping
    class="gondals-freeship{% if remaining <= 0 %} is-unlocked{% endif %}"
    data-key="{{ key | default: 'cart' }}"
    data-percent="{{ percent }}"
  >
    <p class="gondals-freeship__text">
      {%- if remaining > 0 -%}
        {{ 'gondals.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        <span class="gondals-freeship__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg>
        </span>
        {{ 'gondals.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div
      class="gondals-freeship__track"
      role="progressbar"
      aria-label="{{ 'gondals.free_shipping_label' | t }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ percent }}"
    >
      <span class="gondals-freeship__fill" style="width: {{ percent }}%;"></span>
    </div>
  </gondals-free-shipping>
{%- endif -%}
