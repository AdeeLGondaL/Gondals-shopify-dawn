{%- comment -%} Floating WhatsApp chat button. Hidden until a number is set in Theme settings > Gondals. {%- endcomment -%}
{%- assign wa_number = settings.gondals_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
{%- if wa_number != blank -%}
  <a
    href="https://wa.me/{{ wa_number }}{% if settings.gondals_whatsapp_message != blank %}?text={{ settings.gondals_whatsapp_message | url_encode }}{% endif %}"
    class="gondals-whatsapp gondals-whatsapp--{{ settings.gondals_whatsapp_position }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'gondals.whatsapp' | t }}"
  >
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false" fill="currentColor"><path d="M16.04 3C8.86 3 3.02 8.83 3.02 16c0 2.3.6 4.54 1.75 6.52L3 29l6.64-1.74A13 13 0 0 0 16.04 29C23.2 29 29.04 23.17 29.04 16S23.2 3 16.04 3Zm0 23.8c-2 0-3.95-.54-5.66-1.55l-.4-.24-3.94 1.03 1.05-3.84-.26-.4A10.77 10.77 0 0 1 5.2 16c0-5.96 4.86-10.8 10.84-10.8 5.97 0 10.83 4.84 10.83 10.8 0 5.96-4.86 10.8-10.83 10.8Zm5.94-8.09c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.74.16-.21.33-.84 1.06-1.03 1.28-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.63-1.62-.97-.86-1.63-1.93-1.82-2.25-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.57.16-.19.22-.33.33-.54.11-.22.05-.41-.03-.57-.08-.16-.74-1.78-1.01-2.44-.27-.64-.54-.55-.74-.56h-.63c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.71s1.17 3.14 1.33 3.36c.16.22 2.3 3.5 5.57 4.91.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.41.19-1.55-.08-.13-.3-.21-.63-.38Z"/></svg>
  </a>
{%- endif -%}
