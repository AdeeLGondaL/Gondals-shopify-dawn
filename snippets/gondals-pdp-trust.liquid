{%- comment -%} Trust points + payment icons under the buy buttons. {%- endcomment -%}
<div class="gondals-pdp-trust">
  <ul class="gondals-pdp-trust__list" role="list">
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
      <span>{{ 'gondals.trust_shipping' | t }}</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M8 5 4 9l4 4"/></svg>
      <span>{{ 'gondals.trust_returns' | t }}</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      <span>{{ 'gondals.trust_secure' | t }}</span>
    </li>
  </ul>
  {%- if shop.enabled_payment_types.size > 0 -%}
    <ul class="gondals-pdp-trust__pay" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
