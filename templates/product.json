{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "category": {
          "type": "text",
          "settings": {
            "text": "{{ product.type }}",
            "text_style": "uppercase"
          }
        },
        "delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'gondals-delivery', min: 3, max: 7 %}"
          }
        },
        "trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'gondals-pdp-trust' %}"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & delivery",
            "icon": "truck",
            "content": "<p>Placeholder: We ship to Germany and across the EU. Standard delivery takes 3–7 business days. Free shipping on orders over €49, otherwise €4.90.</p>"
          }
        },
        "tab_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns & withdrawal",
            "icon": "return",
            "content": "<p>Placeholder: You can withdraw from your purchase within 14 days of receiving it. Full details are in our withdrawal policy (Widerrufsbelehrung).</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Questions?",
            "icon": "chat_bubble",
            "content": "<p>Email us at <a href=\"mailto:gondals@online.de\">gondals@online.de</a>. We reply within 24 hours.</p>"
          }
        }
      },
      "block_order": [
        "category",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "delivery",
        "trust",
        "description",
        "tab_shipping",
        "tab_returns",
        "tab_care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}