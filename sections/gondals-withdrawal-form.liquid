{%- comment -%}
  Online withdrawal ("Vertrag hier widerrufen"): the customer names the order and
  items and confirms. Submitted through Shopify's contact form to the store email;
  the store must then send the customer a confirmation of receipt.
{%- endcomment -%}
{%- assign legal_menu = linklists[section.settings.menu] -%}

<div class="gondals-legal" style="--gl-pt: {{ section.settings.padding_top }}px; --gl-pb: {{ section.settings.padding_bottom }}px;">
  <div class="gondals-legal__inner page-width">
    {%- if legal_menu.links.size > 0 -%}
      <nav class="gondals-legal__nav" aria-label="{{ legal_menu.title | escape }}">
        <p class="gondals-legal__nav-title">{{ legal_menu.title | escape }}</p>
        <ul class="gondals-legal__nav-list" role="list">
          {%- for link in legal_menu.links -%}
            <li>
              <a
                class="gondals-legal__nav-link{% if link.current %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <article class="gondals-legal__article">
      <h1 class="gondals-legal__title">{{ page.title | escape }}</h1>
      {%- if page.content != blank -%}
        <div class="gondals-legal__body rte">{{ page.content }}</div>
      {%- endif -%}

      {%- form 'contact', id: 'WithdrawalForm', class: 'gondals-withdrawal' -%}
        {%- if form.posted_successfully? -%}
          <div class="gondals-withdrawal__notice gondals-withdrawal__notice--success" role="status" tabindex="-1" autofocus>
            <p class="gondals-withdrawal__notice-title">{{ 'gondals.withdrawal.success_title' | t }}</p>
            <p>{{ 'gondals.withdrawal.success_text' | t }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="gondals-withdrawal__notice gondals-withdrawal__notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[Subject]" value="{{ 'gondals.withdrawal.subject' | t }}">

          <div class="gondals-withdrawal__grid">
            <div class="field">
              <input class="field__input" type="text" id="Withdrawal-name" name="contact[name]" autocomplete="name" required placeholder=" " value="{{ form.name }}">
              <label class="field__label" for="Withdrawal-name">{{ 'gondals.withdrawal.name' | t }} *</label>
            </div>
            <div class="field">
              <input class="field__input" type="email" id="Withdrawal-email" name="contact[email]" autocomplete="email" required placeholder=" " value="{{ form.email }}">
              <label class="field__label" for="Withdrawal-email">{{ 'gondals.withdrawal.email' | t }} *</label>
            </div>
            <div class="field">
              <input class="field__input" type="text" id="Withdrawal-order" name="contact[Order number]" required placeholder=" ">
              <label class="field__label" for="Withdrawal-order">{{ 'gondals.withdrawal.order' | t }} *</label>
            </div>
            <div class="field">
              <input class="field__input" type="text" id="Withdrawal-date" name="contact[Ordered / received on]" placeholder=" ">
              <label class="field__label" for="Withdrawal-date">{{ 'gondals.withdrawal.date' | t }}</label>
            </div>
          </div>
          <div class="field">
            <textarea class="field__input text-area" id="Withdrawal-items" name="contact[body]" rows="4" required placeholder=" ">{{ form.body }}</textarea>
            <label class="field__label" for="Withdrawal-items">{{ 'gondals.withdrawal.items' | t }} *</label>
          </div>

          <p class="gondals-withdrawal__declaration">{{ 'gondals.withdrawal.declaration' | t }}</p>
          <button type="submit" class="button gondals-withdrawal__submit">{{ 'gondals.withdrawal.submit' | t }}</button>
          <p class="gondals-withdrawal__hint">{{ 'gondals.withdrawal.hint' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </article>
  </div>
</div>

{% schema %}
{
  "name": "Withdrawal form",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Legal pages menu" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "Withdrawal form" }]
}
{% endschema %}

