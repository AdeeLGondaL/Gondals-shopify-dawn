{%- comment -%} Round category shortcuts, scrollable on mobile. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="gondals-cats page-width" style="--gc-pt: {{ section.settings.padding_top }}px; --gc-pb: {{ section.settings.padding_bottom }}px;">
    {%- if section.settings.title != blank -%}
      <h2 class="gondals-section-title h2">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <ul class="gondals-cats__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign label = block.settings.label | default: c.title
          assign link = c.url | default: routes.all_products_collection_url
        -%}
        <li class="gondals-cats__item" {{ block.shopify_attributes }}>
          <a href="{{ link }}" class="gondals-cats__link">
            <span class="gondals-cats__img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: label }}
              {%- elsif c.featured_image -%}
                {{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: label }}
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}&w=400" alt="{{ label | escape }}" loading="lazy" width="400" height="400">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="gondals-cats__label">{{ label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Category circles",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Or external image URL" }
      ]
    }
  ],
  "presets": [{ "name": "Category circles", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
