{%- comment -%} Side-by-side promo banners. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="gondals-tiles page-width" style="--gt-cols: {{ section.blocks.size | at_least: 1 }}; --gtl-pt: {{ section.settings.padding_top }}px; --gtl-pb: {{ section.settings.padding_bottom }}px;">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="gondals-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'gondals-tile__img', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200' }}
        {%- elsif block.settings.image_url != blank -%}
          <img class="gondals-tile__img" src="{{ block.settings.image_url }}&w=1200" alt="" loading="lazy" width="1200" height="800">
        {%- endif -%}
        <span class="gondals-tile__shade"></span>
        <span class="gondals-tile__content">
          {%- if block.settings.eyebrow != blank -%}<span class="gondals-tile__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
          <span class="gondals-tile__heading">{{ block.settings.heading | escape }}</span>
          {%- if block.settings.button_label != blank -%}<span class="gondals-tile__cta">{{ block.settings.button_label | escape }} &rarr;</span>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Or external image URL" },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Limited offer" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Promo heading" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Promo tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
