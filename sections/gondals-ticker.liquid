{%- comment -%} Infinite scrolling ticker (brand strip). {%- endcomment -%}
<div class="gondals-ticker color-{{ section.settings.color_scheme }} gradient" style="--gt-speed: {{ section.settings.speed }}s;">
  <div class="gondals-ticker__track" aria-hidden="true">
    {%- for n in (1..2) -%}
      <ul class="gondals-ticker__group" role="list">
        {%- for block in section.blocks -%}
          <li class="gondals-ticker__item" {{ block.shopify_attributes }}>
            <span class="gondals-ticker__dot"></span>{{ block.settings.text | escape }}
          </li>
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <li class="gondals-ticker__item"><span class="gondals-ticker__dot"></span>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
  <p class="visually-hidden">{% for block in section.blocks %}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
</div>

{% schema %}
{
  "name": "Scrolling ticker",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 5, "unit": "s", "label": "Loop duration", "default": 35 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping from €49" }] }
  ],
  "presets": [{ "name": "Scrolling ticker", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
