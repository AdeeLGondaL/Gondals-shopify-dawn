{%- comment -%} Promo slideshow. Each slide takes an uploaded image or an external image URL. {%- endcomment -%}
<div class="gondals-hero{% if section.settings.full_width == false %} page-width{% endif %}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="gondals-hero__track" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.aria_label | escape }}">
    {%- for block in section.blocks -%}
      <div class="gondals-hero__slide gondals-hero__slide--{{ block.settings.align }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}{%- assign hero_loading = 'eager' -%}{%- else -%}{%- assign hero_loading = 'lazy' -%}{%- endif -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'gondals-hero__img', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: hero_loading }}
        {%- elsif block.settings.image_url != blank -%}
          <img class="gondals-hero__img" src="{{ block.settings.image_url }}&w=2000" srcset="{{ block.settings.image_url }}&w=800 800w, {{ block.settings.image_url }}&w=1400 1400w, {{ block.settings.image_url }}&w=2000 2000w" sizes="100vw" alt="" width="2000" height="900" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- endif -%}
        <div class="gondals-hero__overlay" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }};"></div>
        <div class="gondals-hero__content page-width">
          <div class="gondals-hero__box">
            {%- if block.settings.eyebrow != blank -%}<p class="gondals-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="gondals-hero__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="gondals-hero__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="button gondals-hero__btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="gondals-hero__arrow gondals-hero__arrow--prev" aria-label="Previous slide">&#8249;</button>
    <button type="button" class="gondals-hero__arrow gondals-hero__arrow--next" aria-label="Next slide">&#8250;</button>
    <div class="gondals-hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="gondals-hero__dot{% if forloop.first %} is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    var track = root.querySelector('.gondals-hero__track');
    var slides = root.querySelectorAll('.gondals-hero__slide');
    var dots = root.querySelectorAll('.gondals-hero__dot');
    if (slides.length < 2) return;
    var i = 0, timer;
    function go(n) {
      i = (n + slides.length) % slides.length;
      track.scrollTo({ left: slides[i].offsetLeft, behavior: 'smooth' });
    }
    track.addEventListener('scroll', function () {
      var n = Math.round(track.scrollLeft / track.clientWidth);
      if (n !== i) i = n;
      dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
    }, { passive: true });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { go(k); restart(); }); });
    root.querySelector('.gondals-hero__arrow--prev').addEventListener('click', function () { go(i - 1); restart(); });
    root.querySelector('.gondals-hero__arrow--next').addEventListener('click', function () { go(i + 1); restart(); });
    function restart() {
      clearInterval(timer);
      if (root.dataset.autoplay === 'true') timer = setInterval(function () { go(i + 1); }, (parseInt(root.dataset.speed, 10) || 5) * 1000);
    }
    root.addEventListener('mouseenter', function () { clearInterval(timer); });
    root.addEventListener('mouseleave', restart);
    restart();
  })();
</script>

{% schema %}
{
  "name": "Gondals slideshow",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Change slides every", "default": 5 },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Promotions" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Or external image URL", "info": "Used when no image is uploaded." },
        { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay", "default": 35 },
        { "type": "select", "id": "align", "label": "Text position", "default": "left", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
        ] },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New arrivals" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Gondals slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
